{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "read", "resource": ".local/*", "effect": "deny" },
    { "action": "edit", "resource": ".local/*", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "*publish*", "effect": "ask" }
  ],
  "mcp": {
    "servers": {
      "openmontage-studio": {
        "type": "local",
        "command": [
          "C:\\Users\\LENOVO\\AppData\\Local\\Programs\\OpenMontage Studio\\OpenMontage Studio.exe",
          "--mcp"
        ]
      }
    }
  }
}
